#!/usr/bin/env sh

# Block direct pushes to master — require PRs
protected_branch="master"
current_branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$current_branch" = "$protected_branch" ]; then
  echo ""
  echo "BLOCKED: Direct push to '$protected_branch' is not allowed."
  echo "Create a feature branch and open a pull request instead:"
  echo ""
  echo "  git checkout -b feature/my-change"
  echo "  git push -u origin feature/my-change"
  echo "  gh pr create"
  echo ""
  echo "To bypass in emergencies: git push --no-verify"
  exit 1
fi

# Run type-check and tests before pushing
cd asmita
echo "Running type-check..."
npm run type-check || exit 1
echo "Running tests..."
npm run test || exit 1
