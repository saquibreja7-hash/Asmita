#!/usr/bin/env sh

# 1. Lint staged files (config at repo root .lintstagedrc.json)
npx --prefix asmita lint-staged

# 2. Secret scanning with gitleaks
if [ -f "asmita/tools/gitleaks.exe" ]; then
  asmita/tools/gitleaks.exe protect --staged --verbose
elif command -v gitleaks &> /dev/null; then
  gitleaks protect --staged --verbose
else
  echo "Warning: gitleaks not found, skipping secret scan"
fi
