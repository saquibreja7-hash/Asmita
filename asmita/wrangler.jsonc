{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asmita",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/cloudflare-worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "5f54acb46aac45beb104c5d6eaaa9b90"
    }
  ],
  "triggers": {
    "crons": [
      "30 20 * * *",
      "30 22 * * *"
    ]
  }
}
