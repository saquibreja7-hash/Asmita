{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asmita",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/cloudflare-worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "30 20 * * *",
      "30 22 * * *"
    ]
  }
}
