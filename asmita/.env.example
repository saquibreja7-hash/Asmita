# =============================================================================
# Local development defaults. Copy to .env.local and fill in.
# Production values are Cloudflare Worker secrets or bindings, NEVER values in this file.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Local: a Postgres server on your machine, OR leave DATABASE_URL unset to use
#   the in-memory store (store.ts) with no Postgres required.
# Cloudflare production: PostgreSQL remains the system of record. Prefer a
#   Hyperdrive binding named HYPERDRIVE. Until that binding is wired, DATABASE_URL
#   may be used as a temporary staging fallback. Migrations always use DIRECT_URL
#   from a trusted operator machine or CI environment. Supabase examples:
#     DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require&pgbouncer=true
#     DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
#   Use the session pooler as DIRECT_URL when the migration machine has no IPv6
#   route to the direct database hostname.
#   SHADOW_DATABASE_URL only needed if running `prisma migrate dev` against
#   a remote DB; usually leave unset in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asmita
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asmita_shadow
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/asmita

# --- Secrets (generate with `openssl rand -hex 32`) -------------------------
ENCRYPTION_KEY=
JWT_SECRET=
CSRF_SECRET=

# --- Email (Resend) ---------------------------------------------------------
# Production: create a Resend API key, verify the meriasmita.org domain in Resend,
# add SPF, DKIM, DMARC DNS records before sending real notices.
RESEND_API_KEY=
EMAIL_FROM="Asmita <Notice@meriasmita.org>"
NOTICE_EMAIL_FROM="Asmita <Notice@meriasmita.org>"
TRANSACTIONAL_EMAIL_FROM="Asmita <Update@meriasmita.org>"
RESEND_FROM_EMAIL="Asmita <Notice@meriasmita.org>"
# The organization inbox that receives outreach-form notifications (volunteer
# applications, training requests, partner inquiries). Unset in local
# development: the notification is logged instead of sent.
ORG_INBOX_EMAIL=
# Resend webhook signing secret (starts with whsec_). Get from Resend dashboard → Webhooks.
RESEND_WEBHOOK_SECRET=

# --- Content provenance (OpenAI) --------------------------------------------
# Powers the optional "deeper check" on /check-image: reads OpenAI's own
# signals (its Content Credentials and SynthID watermark). The image is
# forwarded to OpenAI in memory and never stored by us (see
# docs/adr/002-consented-encrypted-media.md).
#
# Owner decision, 19 November 2026 (ADR 002 "Decision recorded"): this one
# route is allowed in production when ENABLE_PROVENANCE_CHECK=true (it is set
# in the production Worker vars in wrangler.jsonc). Every call still requires
# the adults-only gate and an explicit per-check consent tick, both enforced
# server-side; nothing about the image (bytes, filename, hash) is stored or
# logged. OPENAI_API_KEY is a Worker secret ONLY (`wrangler secret put`) —
# never a var here or in wrangler.jsonc. Without the key the route answers
# 503 "not configured" and the page hides the button.
ENABLE_PROVENANCE_CHECK=
OPENAI_API_KEY=

# --- Queue + persistence ----------------------------------------------------
# Cloudflare Workers are stateless. Current production scheduled work uses the
# PostgreSQL-backed sweep routes invoked by Cloudflare Cron Triggers.
# Every memory persistence option is dev-only.
EMAIL_PROOF_PERSISTENCE=memory
AUDIT_LOG_PERSISTENCE=memory
SECURITY_LOG_PERSISTENCE=memory
# Production MUST set these two to "database": in-memory OTP and notice-dedup
# state does not survive stateless serverless invocations (duplicate notices,
# broken OTP verification across instances).
OTP_PERSISTENCE=memory
NOTICE_DISPATCH_PERSISTENCE=memory

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://meriasmita.org
ADMIN_EMAILS=
# Required: one role for every ADMIN_EMAILS entry. An admin with no entry or
# an unrecognised role cannot sign in (there is no default role). Roles:
# SUPER_ADMIN, LEGAL_ADVISOR, CASE_REVIEWER, GO_EDITOR, SUPPORT_AGENT, e.g.
# ADMIN_ROLES=founder@example.org=SUPER_ADMIN,legal@example.org=LEGAL_ADVISOR
ADMIN_ROLES=
ADMIN_OTP_EMAIL=
# Survivor OTP emails per hour across the whole site (default 300).
OTP_GLOBAL_HOURLY_LIMIT=

# --- Alerting ---------------------------------------------------------------
ON_CALL_WEBHOOK_URL=
ON_CALL_WEBHOOK_FORMAT=generic
ON_CALL_MIN_SEVERITY=warning

# --- Feature flags ----------------------------------------------------------
# Hash upload is Phase 2; platform API integrations are gated until verified.
ENABLE_HASH_UPLOAD=false
ENABLE_PLATFORM_API=false
# Hash-matching crawler (app side). A deployment switch, not a dev bypass:
# while false every /api/crawler/* route answers 503 and survivors cannot sign
# a crawl authorisation (withdrawing one always works). The crawler service
# authenticates with a key from scripts/issue-crawler-service-key.mjs.
ENABLE_CRAWLER=false
# Whether the survivor sees links the crawler found (website name only): her
# case page and the case APIs. On unless "false"; an open owner decision
# (ADR 006). Her data export always lists them (labelled "Found by Asmita"),
# and admin views are unaffected. Read only in src/lib/crawler-flags.ts.
CRAWLER_SHOW_FINDINGS_TO_SURVIVOR=true
# Crawler v2 (WP1): defaults for sources created automatically. When a
# survivor's submitted link or an approved crawler finding names a host, the
# app creates an enabled REPORTED source for that host with this page budget
# and delay (clamped to the admin bounds; unset or invalid values fall back
# to the defaults shown). Read only in src/lib/crawler-flags.ts.
# CRAWLER_DISCOVERED_PAGE_BUDGET is used from WP5 on, for sites the crawler
# finds by following links.
CRAWLER_REPORTED_PAGE_BUDGET=2000
CRAWLER_DISCOVERED_PAGE_BUDGET=200
CRAWLER_DEFAULT_DELAY_MS=1500
# Crawler v2 WP5: a site the crawler discovers by following links becomes a
# DISCOVERED source one hop deeper than the source it was linked from. It is
# switched on automatically while its hops are within CRAWLER_MAX_DISCOVERY_HOPS
# (default 2; deeper sites are stored switched off for an admin), and at most
# CRAWLER_MAX_NEW_SITES_PER_DAY (default 200) are switched on per UTC day —
# the rest are stored switched off. Read only in src/lib/crawler-flags.ts.
CRAWLER_MAX_DISCOVERY_HOPS=2
CRAWLER_MAX_NEW_SITES_PER_DAY=200
# Crawler v2 review fix: the most frontier rows one source may hold (default
# 50000, clamped to 1000..1000000). Links reported beyond it are dropped, so a
# huge site's backlog cannot grow without bound. Read only in
# src/lib/crawler-flags.ts.
CRAWLER_FRONTIER_MAX_PAGES_PER_SOURCE=50000
# SSCD, the second matching layer (ADR 008, WP28). A deployment switch like
# ENABLE_CRAWLER, off by default and never set in wrangler.jsonc: while false
# the embeddings route answers 503 crawler_disabled and the pool serves no
# vectors, exactly as before this feature existed. The crawler computes the
# descriptors of analyst-confirmed copies; the app never sees an image.
ENABLE_SSCD=false
# Which SSCD descriptor the deployment serves and accepts (the model id and
# its version tag). Vectors are comparable only within one model + version
# pair, so the pool serves, and the embeddings route accepts, only these. An
# unset, empty or over-long (over 64 chars) value falls back to the default
# shown. Read only in src/lib/crawler-flags.ts.
SSCD_MODEL_ID=sscd_disc_mixup
SSCD_MODEL_VERSION=onnx-1
TIER1_API_ENABLED_PLATFORMS=
TIER1_API_ACCESS_TOKEN=
# Per-platform tokens override the shared one: TIER1_API_TOKEN_<PLATFORM_ID>
# (e.g. TIER1_API_TOKEN_X_TWITTER). Outbound request timeout: TIER1_API_TIMEOUT_MS
# (default 10000, clamped 1000-60000). See docs/api/platform-api.md.

# --- Cloudflare Cron --------------------------------------------------------
# Store with `wrangler secret put`. The Worker scheduled handler authenticates
# its internal request to /api/cron/* with this value.
CRON_SECRET=
# Separate secret for /api/health detail (keepalive workflow). Never reuse CRON_SECRET.
HEALTH_CHECK_SECRET=

# --- AI Lab (docs/lab/charter.md) -------------------------------------------
# ENABLE_LAB is a deployment switch read only in src/lib/lab/flags.ts: on in
# dev and test, off in production (wrangler.jsonc) until the owner turns it
# on. The trace tool below also runs in the visitor's browser; its models are
# operator configuration, never committed weights:
#
# LAB_SSCD_MODEL_URL: where /lab/trace fetches the pinned sscd_disc_mixup ONNX
# (the same artifact the crawler's second matching layer uses; fetch
# tools/lab-bench's models:fetch for the file and host it yourself). Unset,
# the trace page says the model-based score is unavailable and compares with
# image hashing (PDQ) only — an honest fallback, never a failure.
# LAB_HUMAN_MODEL_BASE: where the in-browser face-landmark model files live
# (default: the landmark library author's model host, the same place the E1
# harness uses). Point it at a mirror to keep the Lab self-hosted.
# Both are read in src/lib/lab-models.ts (and added to the /lab/trace CSP's
# connect-src when they name another origin).
ENABLE_LAB=
LAB_SSCD_MODEL_URL=
LAB_HUMAN_MODEL_BASE=
#
# The beta tools (docs/lab/beta-spec.md, WP90–WP95). None of these belong in
# wrangler.jsonc: secret-looking ones are Worker secrets (`wrangler secret
# put`), and the Lab stays off in production (ENABLE_LAB "false" there) until
# the owner turns it on.
#
# WP90 detector panel (/lab/detectors): the site-wide daily cap, spent only
# after every earlier check passed. The OpenAI row reuses OPENAI_API_KEY
# (the provenance section above); without a key a detector's row honestly
# answers "not configured". The model and base-URL overrides are optional
# (defaults: gpt-4o-mini, https://api.openai.com/v1, https://api.thehive.ai,
# https://api.sightengine.com).
LAB_DETECTOR_DAILY_LIMIT=200
OPENAI_VISION_MODEL=
OPENAI_BASE_URL=
HIVE_API_KEY=
HIVE_BASE_URL=
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
SIGHTENGINE_BASE_URL=
# WP91 photo protection (/lab/protect): the tool runs entirely in the
# visitor's browser, so this cap has nothing to spend today; it is recorded
# for the day a server-side model returns.
LAB_PROTECT_DAILY_LIMIT=100
# WP93 message check (/lab/message-check): the site-wide daily cap, and the
# Sarvam chat key the home chat (/api/chat) already reads. Without the key
# the code pattern results still render; only the short plain-language
# summary is off.
LAB_MESSAGE_CHECK_DAILY_LIMIT=500
SARVAM_CHAT_KEY=
# WP94 Content Credentials stamp (/lab/stamp): the Lab test certificate and
# its private key, both PEM, both Worker secrets. Without the pair the page
# explains signing is not configured and offers nothing. Never commit a key.
LAB_C2PA_CERT=
LAB_C2PA_KEY=
LAB_STAMP_DAILY_LIMIT=200
# E2 admin console: the RDAP base of the domain-lookup helper. Unset, the
# lookup answers from DNS alone.
LAB_RDAP_BASE_URL=
