generator client {
  provider = "prisma-client-js"
}

// Kysely table types for the Worker (src/lib/worker-kysely.ts). Generated on
// every install and never committed, so they cannot drift from this schema.
generator kysely {
  provider = "prisma-kysely"
  output   = "../src/generated"
  fileName = "kysely-types.ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VICTIM
  SUPPORTER
  NGO_WORKER
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  LEGAL_ADVISOR
  CASE_REVIEWER
  GO_EDITOR
  SUPPORT_AGENT
}

enum CaseStatus {
  OPEN
  PARTIALLY_RESOLVED
  RESOLVED
  CLOSED
  ESCALATED
}

enum PlatformTier {
  TIER_1
  TIER_2
  TIER_3
}

enum NoticeBasis {
  IT_RULES_2021
  DMCA
  IT_RULES_AND_DMCA
  EMAIL_ONLY
  FORM_ONLY
}

enum UrlStatus {
  PENDING_REVIEW
  NOTICE_QUEUED
  NOTICE_SENT
  ESCALATED
  REMOVED
  UNRESOLVED
  REJECTED
}

enum NoticeMethod {
  API
  EMAIL
  FORM_HANDOFF
}

enum ResponseType {
  ACKNOWLEDGED
  REMOVED
  REJECTED
  NO_RESPONSE
}

enum TemplateType {
  IT_RULES_2021
  DMCA
  IT_RULES_AND_DMCA
  ESCALATION_L1
  ESCALATION_L2
  FIR_PACKAGE
  HASH_ADVISORY
  CRAWL_AUTHORISATION
  CRAWL_REPRESENTATIVE_NOTICE
  WATCH_AUTHORISATION
}

// Where a SubmittedUrl came from: the survivor, or an analyst-approved
// crawler finding (CrawlFinding).
enum UrlSource {
  SURVIVOR
  CRAWLER
}

enum CrawlFindingStatus {
  CANDIDATE
  APPROVED
  DISMISSED
}

// What a case is (watch-and-verify WP22). CASE: a takedown complaint with
// links. WATCH: "Watch for my images" — no links, only fingerprints watched
// for copies; nothing is sent to any platform until she chooses "Take it down".
enum CaseMode {
  CASE
  WATCH
}

// What a crawl authorisation covers (WP22). SEARCH_AND_NOTICE: comparison and
// representative notices (the existing tick). WATCH_ONLY: comparison and
// alerting her only; a representative notice is refused (watch_only_consent)
// until she converts the watch into a case and ticks the full authorisation.
enum CrawlConsentScope {
  SEARCH_AND_NOTICE
  WATCH_ONLY
}

enum CrawlSourceKind {
  SITE
}

// How a source entered the list. ADMIN: a SUPER_ADMIN added it. REPORTED: a
// survivor's submitted link or an approved crawler finding named its host.
// DISCOVERED (crawler v2 WP5): an in-scope page linked it.
enum CrawlSourceOrigin {
  ADMIN
  REPORTED
  DISCOVERED
}

// How the crawler fetches a source's pages (crawler v2; HTTP today).
enum CrawlRenderMode {
  HTTP
  BROWSER
  AUTO
}

// Crawler v2 WP3: what a frontier row is (a page to visit; sitemap and feed
// entries arrive from WP4 on) and where it sits in the visit schedule.
enum CrawlPageKind {
  PAGE
  SITEMAP
  FEED
}

// Crawler v2 WP3: the outcome of the last visit. PENDING rows have never been
// fetched. DEAD rows (gone, or five failed visits) are never due again.
enum CrawlPageStatus {
  PENDING
  FETCHED
  NOT_MODIFIED
  GONE
  BLOCKED
  ERROR
  DEAD
}

// Watch-and-verify WP23: the outcome of one scheduled re-check that a link
// reported removed really stayed down. PENDING until the check ran.
enum LinkVerificationOutcome {
  PENDING
  GONE
  STILL_ONLINE
  UNKNOWN
}

// Phase 2 fingerprints: PDQ for images, VPDQ for videos (one PDQ hash per
// sampled frame). The crawler pool serves PDQ rows only until the video
// matcher ships (video-fingerprints spec, rule 3 and WP20).
enum HashAlgorithm {
  PDQ
  VPDQ
}

enum HashSubmissionStatus {
  PENDING_REVIEW
  APPROVED
  DISPATCHED
  REJECTED
}

// How a crawler finding matched (ADR 008, WP28): PDQ or VPDQ (a hash
// distance), or SSCD (a deep-descriptor similarity, no distance). Default
// PDQ: rows written before the second layer existed are image matches.
enum CrawlFindingMethod {
  PDQ
  VPDQ
  SSCD
}

enum AuditEventType {
  USER_REGISTERED
  USER_VERIFIED
  DECLARATION_SIGNED
  CASE_CREATED
  URL_SUBMITTED
  URL_FLAGGED
  URL_APPROVED
  URL_REJECTED
  NOTICE_QUEUED
  NOTICE_SENT
  NOTICE_FAILED
  ESCALATION_L1_TRIGGERED
  ESCALATION_L2_TRIGGERED
  ESCALATION_L3_TRIGGERED
  CONTENT_REMOVED
  CASE_CLOSED
  ADMIN_ACTION
  NGO_VERIFIED
  IDENTITY_VERIFICATION
  CASE_EXPORT
  CASE_DELETION_REQUESTED
  CASE_HARD_DELETED
  GO_DATABASE_CHANGED
  GO_CONTACT_VERIFIED
  TEMPLATE_ACTIVATED
  HASH_SUBMITTED
  HASH_APPROVED
  HASH_REJECTED
  HASH_DISPATCHED
  NOTICE_SIGNED
  URL_PORTAL_ACCESSED
  PLATFORM_FORM_FILED
  URL_REVEALED
  CRAWL_CONSENT_SIGNED
  CRAWL_CONSENT_WITHDRAWN
  CRAWL_FINDING_RECORDED
  CRAWL_FINDING_APPROVED
  CRAWL_FINDING_DISMISSED
  CRAWL_SOURCE_REPORTED
  CRAWL_SOURCE_DISCOVERED
  CRAWL_SOURCE_PROMOTED
  CRAWL_SOURCE_PAUSED
  CRAWL_SOURCE_RESUMED
  // AI Lab (docs/lab/charter.md): every lab mutation audits with its own
  // event name. Data carries ids and counts only, never a service name or URL.
  LAB_SERVICE_CREATED
  LAB_SERVICE_UPDATED
  LAB_CHOKEPOINT_CREATED
  LAB_CHOKEPOINT_UPDATED
  LAB_REPORT_DRAFTED
  LAB_REPORT_UPDATED
  LAB_REPORT_SENT
  LAB_REPORT_OUTCOME_RECORDED
  LAB_LIVENESS_RUN
  WATCH_CONVERTED
  CONTENT_STILL_ONLINE
  CRAWL_WATCH_STARTED
}

enum DeletionJobStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  FAILED
}

// AI Lab (docs/lab/charter.md). E2: nudify-service map and chokepoint
// reporting. Lab data is research data: real names and URLs live only in
// these tables, never in code, fixtures or docs.
enum LabServiceKind {
  APP
  WEBSITE
  CHAT_BOT
  CHANNEL
  SOCIAL_ACCOUNT
}

enum LabServiceStatus {
  ACTIVE
  DOWN
  UNKNOWN
}

enum LabChokepointKind {
  HOST
  CDN
  REGISTRAR
  PAYMENT_PROCESSOR
  APP_STORE
  AD_NETWORK
  PLATFORM_ACCOUNT
}

enum LabReportChannel {
  EMAIL
  WEB_FORM
}

enum LabReportStatus {
  DRAFT
  SENT
}

enum LabReportOutcome {
  ACTIONED
  REFUSED
  NO_REPLY
}

model User {
  id                 String     @id @default(uuid())
  emailHash          String     @unique
  emailEncrypted     String
  emailVerified      Boolean    @default(false)
  aadhaarVerified    Boolean    @default(false)
  digilockerVerified Boolean    @default(false)
  role               UserRole   @default(VICTIM)
  ageOver18          Boolean
  preferredLocale    String?
  createdAt          DateTime   @default(now())
  lastActiveAt       DateTime?
  deactivatedAt      DateTime?

  cases         Case[]     @relation("VictimCases")
  verifiedCases Case[]     @relation("NgoVerifiedCases")
  adminProfile  AdminProfile?
  sessionTokens SessionToken[]
  ngoApiKeys    NgoApiKey[]
}

model Case {
  id                    String     @id @default(uuid())
  referenceNumber       String     @unique
  userId                String
  registrationKeyHash   String?
  status                CaseStatus @default(OPEN)
  // "Watch for my images" (WP22): a watch holds fingerprints and no links.
  mode                  CaseMode   @default(CASE)
  state                 String?
  city                  String?
  ngoVerified           Boolean    @default(false)
  ngoVerifierId         String?
  declarationSignedAt   DateTime?
  declarationIpHash     String?
  firPackageGeneratedAt   DateTime?
  signedHashAdvisoryPdf   String?
  hashAdvisoryPlatformIds String[]  @default([])
  // Fingerprints listed in the signed hash advisory; dispatch sends exactly these.
  hashAdvisorySignedHashIds String[] @default([])
  // The HASH_ADVISORY template the advisory was signed against, and a digest
  // of its text. Dispatch emails exactly this template (src/lib/signed-template.ts).
  hashAdvisorySignedTemplateId     String?
  hashAdvisorySignedTemplateDigest String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  user            User             @relation("VictimCases", fields: [userId], references: [id])
  ngoVerifier     User?            @relation("NgoVerifiedCases", fields: [ngoVerifierId], references: [id])
  submittedUrls   SubmittedUrl[]
  feedback        Feedback[]
  deletionJobs    DeletionJob[]
  hashSubmissions HashSubmission[]
  crawlConsents   CrawlConsent[]
  crawlFindings   CrawlFinding[]

  @@unique([userId, registrationKeyHash])
  @@index([createdAt])
  @@index([status, createdAt])
}

// Phase 2: client-generated perceptual hashes. The hash is the ONLY artifact
// the server ever receives — never image bytes. Encrypted at rest; digest
// column exists solely for dedup/lookup.
// Video fingerprints (video-fingerprints spec WP17): a VPDQ row keeps its
// frame list here (JSON, encrypted like the hash itself); the video never
// reaches the server, only frame hashes, qualities and timestamps. Nullable:
// PDQ image rows have none of these. For a VPDQ row, hashEncrypted holds the
// highest-quality frame's hash and hashDigest the sha256 of the sorted unique
// frame hashes, so the existing unique index dedups re-uploads.
model HashSubmission {
  id                  String               @id @default(uuid())
  caseId              String
  algorithm           HashAlgorithm        @default(PDQ)
  hashEncrypted       String
  hashDigest          String
  quality             Int
  videoFramesEncrypted String?
  videoFrameCount     Int?
  videoDurationSec    Int?
  clientVersion       String?
  status              HashSubmissionStatus @default(PENDING_REVIEW)
  flaggedForReview    Boolean              @default(false)
  flagReason          String?
  submittedAt         DateTime             @default(now())
  reviewedAt          DateTime?
  reviewedById        String?
  requestedPlatformId String?
  // Opaque id the crawler pool lists this fingerprint under. Random, set
  // when a crawl authorisation covering it is signed and cleared when it is
  // withdrawn, so it says nothing about the case and a withdrawn id never
  // matches again (src/lib/crawl-pool.ts).
  crawlPoolId         String?              @unique

  case              Case           @relation(fields: [caseId], references: [id])
  requestedPlatform Platform?      @relation("HashSubmissionPlatform", fields: [requestedPlatformId], references: [id])
  dispatches        HashDispatch[]
  crawlFindings     CrawlFinding[]

  @@unique([caseId, hashDigest])
  @@index([status])
  @@index([caseId])
}

model HashDispatch {
  id               String   @id @default(uuid())
  hashSubmissionId String
  platformId       String
  noticeId         String?
  dispatchedAt     DateTime @default(now())

  hashSubmission HashSubmission @relation(fields: [hashSubmissionId], references: [id])
  platform       Platform       @relation(fields: [platformId], references: [id])
  notice         Notice?        @relation(fields: [noticeId], references: [id])

  @@unique([hashSubmissionId, platformId])
  @@index([platformId])
}

model Platform {
  id                         String       @id @default(uuid())
  name                       String
  domainPatterns             String[]
  tier                       PlatformTier
  noticeBasis                NoticeBasis
  grievanceEmail             String?
  grievanceName              String?
  grievanceAddress           String?
  formUrl                    String?
  apiEndpoint                String?
  responseRate7d             Float?
  lastContactVerifiedAt      DateTime?
  lastContactVerifiedByHuman Boolean      @default(false)
  // Email hash of the admin who last changed the contact fields; a different
  // admin must verify the change.
  contactChangedBy           String?
  contactChangedAt           DateTime?
  isActive                   Boolean      @default(true)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  submittedUrls     SubmittedUrl[]
  noticeTemplates   NoticeTemplate[]
  goHistory         PlatformGoHistory[]
  hashDispatches    HashDispatch[]
  hashSubmissions   HashSubmission[]    @relation("HashSubmissionPlatform")
}

model PlatformGoHistory {
  id          String   @id @default(uuid())
  platformId  String
  fieldName   String
  oldValue    String?
  newValue    String?
  sourceUrl   String?
  verifiedBy  String?
  changedById String?
  createdAt   DateTime @default(now())

  platform Platform @relation(fields: [platformId], references: [id])

  @@index([platformId])
  @@index([createdAt])
}

model SubmittedUrl {
  id               String    @id @default(uuid())
  caseId           String
  urlEncrypted     String
  urlHash          String
  domain           String
  platformId       String?
  status           UrlStatus @default(PENDING_REVIEW)
  submittedAt      DateTime  @default(now())
  flaggedForReview Boolean   @default(false)
  flagReason       String?
  signedNoticePdf  String?
  // Fingerprints listed in the signed notice; dispatch sends exactly these.
  signedHashSubmissionIds String[] @default([])
  // The template the notice was signed against, and a digest of its text.
  // Dispatch emails exactly this template (src/lib/signed-template.ts).
  signedTemplateId     String?
  signedTemplateDigest String?
  // When the survivor said she filed a form-only platform's own form. Starts
  // the escalation ladder for links Asmita cannot email (docs/product/escalation-ladder.md).
  platformFiledAt  DateTime?
  source           UrlSource @default(SURVIVOR)
  // Set when the link came from an approved crawler finding.
  crawlFindingId   String?   @unique
  // Crawler links only (src/lib/crawl-notice.ts). The notice Asmita sends as
  // the survivor's authorised representative, never signed by her: the
  // encrypted PDF of record, a digest of what the analyst previewed, the
  // CRAWL_REPRESENTATIVE_NOTICE template and its text digest, the
  // authorisation (CrawlConsent) it relies on, who sent it and who approved
  // the finding. Kept apart from signedNoticePdf so a representative notice
  // can never pass for a survivor signature.
  representativeNoticePdf      String?
  representativeNoticeDigest   String?
  representativeTemplateId     String?
  representativeTemplateDigest String?
  representativeConsentId      String?
  representativeSentById       String?
  representativeApprovedById   String?
  // Set on an unsent crawler link when the survivor withdrew her crawl
  // authorisation. Permanent: a later authorisation never revives it.
  crawlConsentWithdrawnAt      DateTime?
  // Crawler v2 review fix: whether the hourly sweep has already looked at
  // this link's host for a REPORTED crawl source. Sources are never created
  // inline in her request (that would sit next to her audit entries); the
  // sweep batches unchecked rows, then sets this. Rows that existed before
  // the column were checked by the old inline path, so they read true.
  crawlSourceChecked           Boolean   @default(false)

  case         Case             @relation(fields: [caseId], references: [id])
  platform     Platform?        @relation(fields: [platformId], references: [id])
  crawlFinding CrawlFinding?    @relation(fields: [crawlFindingId], references: [id], onDelete: SetNull)
  notices      Notice[]
  portalTokens UrlPortalToken[]
  verifications LinkVerification[]

  @@index([caseId])
  @@index([crawlSourceChecked])
}

// A survivor's signed authorisation for Asmita's crawler to look for her
// approved fingerprints on public pages. One live (not withdrawn) row per
// case; withdrawn rows stay as the record. The signed PDF is encrypted at
// rest, like every signed document.
model CrawlConsent {
  id                 String    @id @default(uuid())
  caseId             String
  signedPdfEncrypted String
  // Fingerprints listed in the signed authorisation; only these are searched.
  hashSubmissionIds  String[]  @default([])
  // The CRAWL_AUTHORISATION template signed and a digest of its text.
  templateId         String
  templateDigest     String
  signedAt           DateTime  @default(now())
  withdrawnAt        DateTime?
  // What the authorisation covers (WP22). Defaults to the original scope.
  scope              CrawlConsentScope @default(SEARCH_AND_NOTICE)
  // Set on the full (SEARCH_AND_NOTICE) authorisation she signs when she
  // turns a watch into a case ("Take it down"): the WATCH_ONLY authorisation
  // it replaces. Findings recorded under that one stay covered by this one.
  convertedFromId    String?
  // Watch-and-verify WP24: when the case is resolved (or every link on it is
  // verified removed), the live authorisation keeps her fingerprints in the
  // crawler pool until this date (start + 12 months) instead of only while
  // the case is open. Null while the case is open and no watch has started.
  watchUntil         DateTime?

  case Case @relation(fields: [caseId], references: [id])

  @@index([caseId])
}

// A possible copy found by the crawler. URLs are encrypted and, like
// SubmittedUrl, blanked 30 days after firstSeenAt. urlDigest is only for
// dedup within the case and is cleared (NULL) with the URLs.
model CrawlFinding {
  id                String             @id @default(uuid())
  caseId            String
  hashSubmissionId  String
  // The live authorisation (CrawlConsent) the crawler matched under. Part of
  // the dedup digest, so a copy re-reported after she withdrew and signed
  // again becomes a new finding instead of merging into the old one, which
  // stays as the record. Null only for rows written before this column.
  crawlConsentId    String?
  pageUrlEncrypted  String
  imageUrlEncrypted String
  urlDigest         String?
  // Null for an SSCD finding (ADR 008, WP28): the second layer has no PDQ
  // distance. A widening — old rows and old code always wrote one.
  distance          Int?
  // The SSCD similarity when the second layer matched or scored a borderline
  // PDQ match; information for the analyst, never an automatic accept or
  // reject. Null on pure PDQ/VPDQ findings.
  sscdSimilarity    Float?
  quality           Int
  firstSeenAt       DateTime           @default(now())
  lastSeenAt        DateTime           @default(now())
  sourceId          String
  runId             String
  reviewStatus      CrawlFindingStatus @default(CANDIDATE)
  // Which layer matched (ADR 008, WP28). Default PDQ; a video finding is
  // derived from its VPDQ submission, an SSCD finding carries sscdSimilarity.
  method            CrawlFindingMethod @default(PDQ)
  reviewedById      String?
  reviewedAt        DateTime?
  // A second, different analyst confirms an approval before anything acts on it.
  secondReviewedById String?
  secondReviewedAt   DateTime?

  case           Case           @relation(fields: [caseId], references: [id])
  hashSubmission HashSubmission @relation(fields: [hashSubmissionId], references: [id])
  source         CrawlSource    @relation(fields: [sourceId], references: [id])
  submittedUrl   SubmittedUrl?
  embeddings     FindingEmbedding[]

  @@unique([caseId, urlDigest])
  @@index([reviewStatus])
  @@index([firstSeenAt])
  @@index([sourceId])
}

// An SSCD embedding of an ANALYST-CONFIRMED copy (ADR 008, WP28): the crawler
// — never the survivor's device, never the app — computes the descriptor from
// the image bytes it already holds in memory on a match and posts it to
// /api/crawler/embeddings; the app stores it only for APPROVED findings under
// a live authorisation. The vector is encrypted at rest like every other
// secret and never logged; never an image, crop or thumbnail is stored. It is
// deleted with the fingerprint's rejection, the consent's withdrawal or the
// case's erasure (and cascades with its finding); it is NOT subject to the
// 30-day URL blanking.
model FindingEmbedding {
  id               String   @id @default(uuid())
  // The confirmed finding this embedding was seeded from; one per finding.
  findingId        String   @unique
  // The fingerprint the confirmed finding matched (denormalised for the pool
  // lookup and the deletion paths).
  hashSubmissionId String
  caseId           String
  // Which descriptor produced the vector: only rows matching the configured
  // model id + version are served or accepted, so a model change never mixes
  // incomparable vectors.
  model            String
  version          String
  // The L2-normalised float vector, encrypted at rest (encryptField).
  vectorEncrypted  String
  createdAt        DateTime @default(now())

  finding CrawlFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([hashSubmissionId])
  @@index([caseId])
}

// A public site the crawler may visit. ADMIN rows are approved by a human
// (crawl-sources.ts); REPORTED rows are created automatically when a survivor's
// submitted link or an approved crawler finding names their host — the host
// only, never the link or the case (full-crawler spec WP1).
model CrawlSource {
  id         String          @id @default(uuid())
  kind       CrawlSourceKind @default(SITE)
  domain     String          @unique
  pageBudget Int
  delayMs    Int
  enabled    Boolean         @default(false)
  approvedBy String?
  origin     CrawlSourceOrigin @default(ADMIN)
  hops       Int             @default(0)
  // The source a DISCOVERED row was found through (WP5); REPORTED rows set nothing.
  discoveredFromId String?
  render     CrawlRenderMode @default(HTTP)
  lastCrawledAt DateTime?
  pagesCrawled  Int          @default(0)
  // Crawler v2 WP5: automatic lifecycle of a discovered site. Paused = the
  // hourly sweep switched it off for 30 days after its page budget was spent
  // three days running with no match; pauseReason is a fixed code for the
  // admin page. disabledReason records why a discovered site was stored
  // disabled at birth ("max_hops" beyond the hop limit, "daily_cap" beyond
  // the new-sites-per-day cap); both clear when an admin switches it on.
  pausedUntil    DateTime?
  pauseReason    String?
  disabledReason String?
  createdAt  DateTime        @default(now())

  findings CrawlFinding[]
  pages    CrawlPage[]
  days     CrawlSourceDay[]
}

// Pages a source fetched per UTC day, counted when the crawler reports them
// (crawler v2 review fix). CrawlPage.lastFetchedAt is overwritten by every
// revisit, so it cannot say how many pages a source fetched on an earlier
// day; the discovered-site pause ("budget spent three days running") reads
// these counters instead. Counts only, no address. The hourly sweep prunes
// rows older than a week.
model CrawlSourceDay {
  sourceId     String
  // Start of the UTC day.
  day          DateTime
  pagesFetched Int      @default(0)

  source CrawlSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([sourceId, day])
  @@index([day])
}

// Hosts that must never become a crawl source through the automatic paths,
// on top of the built-in list in src/lib/crawl-never.ts. Managed by admins
// (crawler v2 WP2). A host is blocked if it equals a row's host or is a
// subdomain of one.
model CrawlBlockedHost {
  id        String   @id @default(uuid())
  host      String   @unique
  reason    String
  addedBy   String
  createdAt DateTime @default(now())
}

// One page URL of one source waiting to be crawled (crawler v2 WP3). The app
// owns the frontier: the crawler claims batches and reports outcomes, so a
// second run resumes where the last one stopped instead of starting from the
// home page. The URL is encrypted at rest (encryptField); every lookup and
// the per-source dedup use urlDigest, a keyed digest of the URL with tracking
// parameters stripped (crawl-pages.ts). Never fetched, never logged, never in
// audit data; purged like findings after 30 days (url-retention.ts) except
// rows that are still due for crawling.
model CrawlPage {
  id            String          @id @default(uuid())
  sourceId      String
  urlEncrypted  String
  urlDigest     String
  // BFS depth from the source seed; the crawler reports no links from a page
  // at its MAX_DEPTH, so depths stay bounded by the crawler's own config.
  depth         Int             @default(0)
  kind          CrawlPageKind   @default(PAGE)
  // Crawl order (crawler v3 WP11): lower runs first; the claim orders by
  // priority, then nextDueAt. 100 is the default every row stored before
  // WP11 keeps; a reported link sets it — sitemap 10, feed 20, pagination
  // 30, other pages 50 plus 10 per depth level (capped at 100) — and a
  // sitemap entry whose lastmod is newer than the row's last fetch jumps
  // the queue at 5, due immediately.
  priority      Int             @default(100)
  // Stored from a pagination link (crawler v3 review fix): the canonical
  // aliases such a page reports (page 2 naming page 1) are ignored.
  viaPagination Boolean         @default(false)
  // Validators the crawler sent as If-None-Match / If-Modified-Since.
  etag          String?
  lastModified  String?
  status        CrawlPageStatus @default(PENDING)
  // Claimed rows are not handed out again for 30 minutes, so two crawler
  // processes never fetch the same URL; a killed run's batch becomes due
  // again when the claim expires.
  claimedUntil  DateTime?
  lastFetchedAt DateTime?
  // Crawler v3 review fix (WP13): the first permanent fetch failure (a DNS
  // name that does not exist, a definite TLS certificate failure) — the row
  // dies only on a permanent failure at least 24 h after this one; a
  // successful visit clears it. Null before the first permanent failure.
  lastPermanentFailAt DateTime?
  nextDueAt     DateTime        @default(now())
  failCount     Int             @default(0)
  createdAt     DateTime        @default(now())

  source CrawlSource @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, urlDigest])
  @@index([sourceId, nextDueAt])
  @@index([sourceId, lastFetchedAt])
  @@index([sourceId, priority, nextDueAt])
}

// Watch-and-verify WP23: one scheduled re-check that a link reported removed
// really stayed down. When one of her links becomes REMOVED (she marks it, or
// a platform's recorded reply says so), three checks are scheduled — one day,
// three days and seven days later (attempt 1..3). The hourly retention cron
// puts each due check into the crawler frontier as a priority row for its
// host's source and later resolves the outcome from the crawler's report. No
// URL is stored here: the check works from the SubmittedUrl it references,
// which is why nothing in this table needs the retention blanking. Completed
// rows are the admin case page's verification history; erased with the link.
model LinkVerification {
  id             String                 @id @default(uuid())
  submittedUrlId String
  dueAt          DateTime
  // 1, 2 or 3: the +1/+3/+7 day check.
  attempt        Int
  outcome        LinkVerificationOutcome @default(PENDING)
  checkedAt      DateTime?
  // When the hourly sweep put the check into the crawler frontier; null until
  // then. Findings are counted against this moment ("since the check was
  // queued"), and a check that was never answered by a crawler visit gives
  // up as UNKNOWN a bounded time after it.
  enqueuedAt     DateTime?
  createdAt      DateTime               @default(now())

  submittedUrl SubmittedUrl @relation(fields: [submittedUrlId], references: [id])

  @@index([outcome, dueAt])
  @@index([submittedUrlId])
}

// Bearer keys for the crawler service. Only a sha256 of the key is stored
// (scripts/issue-crawler-service-key.mjs).
model CrawlServiceKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?
}

// One-time access tokens for URLs sent in notice emails. The raw URL never
// appears in email — only the portal link. The platform officer enters an
// access code to view the URL once; the token is then permanently consumed.
model UrlPortalToken {
  id             String    @id @default(uuid())
  urlId          String
  token          String    @unique
  accessCodeHash String
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  submittedUrl SubmittedUrl @relation(fields: [urlId], references: [id])

  @@index([token])
  @@index([urlId])
}

model NoticeTemplate {
  id              String       @id @default(uuid())
  platformId      String?
  templateType    TemplateType
  subjectTemplate String
  bodyTemplate    String
  legalCitations  Json
  reviewedByLegal Boolean      @default(false)
  reviewedAt      DateTime?
  reviewedByName  String?
  isActive        Boolean      @default(true)
  version         Int          @default(1)
  createdAt       DateTime     @default(now())

  platform Platform? @relation(fields: [platformId], references: [id])
  notices  Notice[]
}

model Notice {
  id                 String        @id @default(uuid())
  urlId              String
  templateId         String?
  routingTier        Int
  method             NoticeMethod
  sentAt             DateTime?
  recipientEmail     String?
  messageId          String?
  payloadHash        String?
  responseReceivedAt DateTime?
  responseType       ResponseType?
  removedAt          DateTime?
  escalationLevel    Int           @default(0)
  // Set on follow-up emails: the original notice they follow. The escalation
  // sweep only walks originals, so a follow-up never starts a ladder of its own.
  followUpOf         String?
  createdAt          DateTime      @default(now())

  submittedUrl   SubmittedUrl    @relation(fields: [urlId], references: [id])
  template       NoticeTemplate? @relation(fields: [templateId], references: [id])
  escalations    Escalation[]
  hashDispatches HashDispatch[]

  @@index([urlId])
}

model EmailDeliveryProof {
  id           String   @id @default(uuid())
  provider     String
  messageId    String
  eventType    String
  platformId   String?
  rawEventHash String
  receivedAt   DateTime @default(now())

  @@index([messageId])
  @@index([platformId])
  @@index([receivedAt])
  @@unique([provider, messageId, eventType, rawEventHash])
}

model Escalation {
  id          String    @id @default(uuid())
  noticeId    String
  level       Int
  triggeredAt DateTime  @default(now())
  actionType  String
  completedAt DateTime?

  notice Notice @relation(fields: [noticeId], references: [id])
}

model AuditLog {
  id           String         @id @default(uuid())
  sequence     Int            @unique
  eventType    AuditEventType
  entityType   String?
  entityId     String?
  actorId      String?
  data         Json?
  ipHash       String?
  previousHash String
  eventHash    String         @unique
  createdAt    DateTime       @default(now())

  // actorId is a survivor's User id or an admin id (admin-...), so it has no
  // foreign key; the log is append-only and outlives the actors it records.
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model OtpToken {
  id             String   @id @default(uuid())
  emailHash      String
  tokenHash      String
  expiresAt      DateTime
  used           Boolean  @default(false)
  failedAttempts Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([emailHash])
}

model SessionToken {
  id           String   @id @default(uuid())
  userId       String
  tokenHash    String   @unique
  namespace    String
  expiresAt    DateTime
  lastSeenAt   DateTime @default(now())
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model AdminProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  role      AdminRole
  mfaSecret String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

/// Per-admin authenticator secret, encrypted at rest. Keyed by email hash so
/// it needs no User row. See src/lib/auth/admin-mfa-store.ts.
model AdminMfaSecret {
  emailHash       String    @id
  secretEncrypted String
  enrolledAt      DateTime  @default(now())
  confirmedAt     DateTime?
  lastUsedAt      DateTime?
}

model AdminAccessLog {
  id         String   @id @default(uuid())
  adminId    String?
  action     String
  // What the admin opened or revealed (a Case or SubmittedUrl id) and, for a
  // reveal, the reason they gave. Never the URL itself.
  entityType String?
  entityId   String?
  reason     String?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([entityId])
}

model NgoApiKey {
  id          String    @id @default(uuid())
  partnerName String
  keyHash     String    @unique
  scopes      String[]  @default([])
  issuedById  String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  issuedBy User? @relation(fields: [issuedById], references: [id])

  @@index([partnerName])
}

model Feedback {
  id            String   @id @default(uuid())
  caseId        String?
  caseReference String?
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())

  case Case? @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([createdAt])
}

// A platform asking to join the partner programme (/for-platforms). Business
// contact details only, never survivor data. Name, email, phone and message
// are encrypted at rest (encryptField); the rest is plain so the console can
// sort and filter. status: NEW, CONTACTED, ONBOARDED or DECLINED.
model PlatformPartnerApplication {
  id               String   @id @default(uuid())
  organisationName String
  platformName     String
  websiteDomain    String
  platformType     String
  userBase         String
  contactName      String
  contactRole      String
  contactEmail     String
  contactPhone     String?
  interests        String[] @default([])
  message          String?
  status           String   @default("NEW")
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model DeletionJob {
  id          String            @id @default(uuid())
  caseId      String
  requestedAt DateTime          @default(now())
  scheduledAt DateTime
  completedAt DateTime?
  status      DeletionJobStatus @default(SCHEDULED)
  error       String?

  case Case @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([scheduledAt])
  @@index([status])
}

model SecurityEventLog {
  id        String   @id @default(uuid())
  event     String
  actorHash String?
  route     String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

// Fixed-window rate limit counters shared by every Worker isolate. The key is
// a sha256 of the bucket name, so no IP or email is stored.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime @default(now())
  count       Int      @default(0)

  @@index([windowStart])
}

// One-time code a SUPER_ADMIN (or the bootstrap script) issues so a named
// admin can sign in once and enrol an authenticator. Stored hashed, single
// use, short-lived. Replaces the shared ADMIN_TOTP_SECRET bootstrap.
model AdminEnrolmentCode {
  emailHash String   @id
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  createdBy String
}

// An admin's own saved filter of the case list (a query string), by name.
model AdminSavedView {
  id             String   @id @default(uuid())
  ownerEmailHash String
  name           String
  query          String
  createdAt      DateTime @default(now())

  @@unique([ownerEmailHash, name])
  @@index([ownerEmailHash])
}

// E2 (Lab charter): a service that makes 'undress' or face-swap images.
// Real names and URLs live only here and in LabChokepoint, never in code.
model LabService {
  id            String           @id @default(uuid())
  name          String
  kind          LabServiceKind
  // The service's public addresses, entered by an analyst. The daily
  // liveness check fetches exactly these.
  urls          String[]         @default([])
  status        LabServiceStatus @default(UNKNOWN)
  // Latest liveness result per URL, set by the daily check only:
  // [{ url, up, checkedAt }] (zod-parsed in src/lib/lab/lab-services.ts).
  urlStatuses   Json?
  // First time the daily check saw every URL down; cleared when one answers
  // again. Basis of the "first report to down" metric.
  downSince     DateTime?
  firstSeenAt   DateTime         @default(now())
  lastCheckedAt DateTime?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  chokepoints LabChokepoint[]

  @@index([status])
}

// E2: one company a service depends on, with the abuse contact an analyst
// copied from that provider's own abuse page.
model LabChokepoint {
  id            String            @id @default(uuid())
  serviceId     String
  kind          LabChokepointKind
  provider      String
  abuseContact  String
  evidenceNotes String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  service LabService   @relation(fields: [serviceId], references: [id])
  reports LabReport[]

  @@index([serviceId])
}

// E2: one abuse report to one chokepoint. Drafted from the per-kind
// template, reviewed by the analyst, then sent by email or copied into a
// web form; the outcome is recorded when the provider replies (or does not).
model LabReport {
  id               String            @id @default(uuid())
  chokepointId     String
  // The chokepoint kind the draft was rendered from (report-templates.ts).
  templateKind     LabChokepointKind
  channel          LabReportChannel?
  subject          String
  body             String
  status           LabReportStatus   @default(DRAFT)
  toAddress        String?
  sentAt           DateTime?
  sentById         String?
  providerReference String?
  outcome          LabReportOutcome?
  outcomeAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  chokepoint LabChokepoint @relation(fields: [chokepointId], references: [id])

  @@index([chokepointId])
  @@index([status])
}
