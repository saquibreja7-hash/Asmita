{
  "name": "asmita",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "test:load": "tsx tests/load/submission-load.ts",
    "security:audit": "npm audit --audit-level=high --omit=dev",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "seed": "prisma db seed",
    "import:platforms": "tsx scripts/import-platforms-csv.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:staging": "npm run build:vinext && vinext-cloudflare deploy --config dist/server/wrangler.json --name asmita-staging",
    "deploy:production": "npm run build:vinext && vinext-cloudflare deploy --config dist/server/wrangler.json --name asmita-production"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.2.8",
    "@fontsource/noto-serif-devanagari": "^5.2.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "bullmq": "^5.76.7",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "kysely": "^0.28.17",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "regenerator-runtime": "^0.14.1",
    "resend": "^6.12.3",
    "vinext": "^1.0.0-beta.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@cloudflare/vite-plugin": "^1.54.10",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@vitest/ui": "^4.1.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jpeg-js": "^0.4.4",
    "jsdom": "^29.1.1",
    "prisma": "^7.9.1",
    "proxy-agent": "^8.0.2",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.132.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "postcss": "^8.5.25",
    "sharp": "^0.35.4",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.3",
    "qs": "^6.16.0",
    "puppeteer-core": "^25.10.0",
    "@puppeteer/browsers": "^3.2.2"
  },
  "type": "module"
}
