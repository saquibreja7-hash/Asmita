# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.lighthouseci/

# next.js
/.next/
/out/
.next-old-*/
test-results/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/dist/
.vinext/
.wrangler/

# generated from prisma/schema.prisma on install
/src/generated/

# c2pa-web engine files copied from node_modules on install
# (scripts/copy-c2pa-assets.mjs; the WASM must ship from our own origin)
/public/c2pa/

# onnxruntime-web's WASM engine and the face-landmark library's browser
# build copied from node_modules on install (scripts/copy-lab-assets.mjs;
# the Lab trace tool loads both same-origin)
/public/ort/
/public/human/
