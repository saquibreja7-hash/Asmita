{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/lib/*": ["../../asmita/src/lib/*"]
    }
  },
  "include": ["src", "tests"]
}
