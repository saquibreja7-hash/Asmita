{
  "name": "lab-bench",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build-set": "tsx src/cli.ts build-set",
    "match": "tsx src/cli.ts match",
    "detect": "tsx src/cli.ts detect",
    "trace": "tsx src/cli.ts trace",
    "report": "tsx src/cli.ts report",
    "models:fetch": "node scripts/fetch-models.mjs",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run test"
  },
  "dependencies": {
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@vladmandic/human": "^3.3.6",
    "onnxruntime-node": "^1.22.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
