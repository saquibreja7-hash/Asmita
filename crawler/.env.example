# Asmita crawler configuration. Placeholders only: never commit real values.
# In production these come from Cloud Run job env vars and Secret Manager.

# Required
ASMITA_API_URL=https://asmita.example
# The key: in production a file mounted from Secret Manager (recommended),
# locally the key itself. Set exactly one of the two.
CRAWLER_SERVICE_KEY_FILE=/secrets/crawler-service-key
# CRAWLER_SERVICE_KEY=<local-test-key-min-32-printable-chars>
CRAWLER_USER_AGENT=AsmitaCrawler/1.0 (+https://asmita.example/crawler)

# Run limits (defaults shown)
MAX_RUN_MINUTES=50
MAX_PAGES=5000
MAX_IMAGES=20000
MAX_DEPTH=5
MAX_LINKS_PER_PAGE=500
MAX_IMAGES_PER_PAGE=200
MAX_SITEMAP_URLS=5000
MAX_QUERY_VARIANTS_PER_PATH=8
MAX_DISCOVERY_HOSTS=1000
FRONTIER_CLAIM_LIMIT=50
GLOBAL_CONCURRENCY=4
# Sources crawled at once (v2 WP6); each source is sequential and every
# request still passes GLOBAL_CONCURRENCY and the per-host delay.
CRAWLER_SOURCE_CONCURRENCY=8
# `run --loop` only: seconds to sleep after a pass that found nothing due.
LOOP_IDLE_SECONDS=60
# Seconds between the periodic run_progress log lines.
PROGRESS_LOG_SECONDS=60
DECODE_CONCURRENCY=1
DECODE_TIMEOUT_MS=20000
POOL_RESYNC_MINUTES=30

# Browser rendering (WP7, defaults shown); only sources with render =
# BROWSER (or AUTO pages with scripts and no image candidates) use it.
BROWSER_PAGE_TIMEOUT_MS=30000
BROWSER_SCROLLS=5
# Wait after each scroll; also the upper limit of the network-quiet window
# that replaces the fixed wait after scrolling (crawler v3 WP15).
BROWSER_SCROLL_WAIT_MS=500
# Requests one rendered page may make. Fonts, audio/video media and the
# built-in advertising/analytics host list are aborted before routing and
# do not count against this cap (crawler v3 WP15).
BROWSER_MAX_REQUESTS_PER_PAGE=300
BROWSER_MAX_PAGE_BYTES=67108864
# Must be a tmpfs (memory): Chromium's throwaway profile lives here.
BROWSER_TMP_DIR=/dev/shm

# Fetching (defaults shown)
MAX_HTML_BYTES=2097152
MAX_IMAGE_BYTES=10485760
MIN_IMAGE_SIDE=64
OFFSITE_HOST_DELAY_MS=1000
MAX_OFFSITE_IMAGE_HOSTS=50
MAX_OFFSITE_HOST_FAILURES=20
MAX_CRAWL_DELAY_MS=30000
CONNECT_TIMEOUT_MS=10000
HEADERS_TIMEOUT_MS=15000
BODY_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=30000
FETCH_ATTEMPTS=3

# Asmita API calls (defaults shown)
API_TIMEOUT_MS=30000
API_ATTEMPTS=4

SHUTDOWN_GRACE_MS=5000
LOG_LEVEL=info

# Read by libvips at load time, not by the crawler config. The container sets
# it; set it in your shell when running locally.
VIPS_DISC_THRESHOLD=2g
